# =============================================================
# PhotoRoom + Vendoo Automation — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================

# --- Application Mode ---
# Options: mock | production
APP_MODE=mock

# --- PhotoRoom API ---
# Get your API key at: https://app.photoroom.com/api-dashboard
PHOTOROOM_API_KEY=YOUR_API_KEY_HERE
# Enable sandbox mode for testing (watermarked output, no credits consumed)
PHOTOROOM_SANDBOX_MODE=true

# --- AI / LLM ---
# Provide the API key for your chosen LLM provider.
# Supported: openai, google, mock
LLM_PROVIDER=mock
OPENAI_API_KEY=YOUR_API_KEY_HERE
GOOGLE_AI_API_KEY=YOUR_API_KEY_HERE

# --- Database ---
DATABASE_PATH=./data/db/app.db

# --- Storage ---
OUTPUT_DIR=./data/output

# --- Logging ---
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_DIR=./logs
